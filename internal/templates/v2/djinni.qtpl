{% func djinni() %}
<figure class="hero__figure-donate">
	<img
		src="/assets/images/djinni.jpeg"
		alt="Anonymous job search for developers – Djinni"
	/>
	<figcaption class="hero__figcaption">
		Anonymous job search for developers and everyone working in tech.
	</figcaption>
</figure>
<button class="hero__donate-button">
	{% if djinniSignUpOrJobs() %}
		<a href="https://djinni.co/jobs?lang=en&from=u8" class="hero__donate-link">Browse jobs</a>
	{% else %}
		<a href="https://djinni.co/signup?lang=en&from=u8" class="hero__donate-link">Sign up</a>
	{% endif %}
</button>
{% endfunc %}
